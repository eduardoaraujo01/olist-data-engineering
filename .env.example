# Credenciais apenas para a instalação local de desenvolvimento.
# O arquivo .env com senhas reais não deve ser versionado.
MINIO_ROOT_USER=olistdev
MINIO_ROOT_PASSWORD=troque-por-uma-senha-local-forte
POSTGRES_DB=olist_analytics
POSTGRES_USER=olist
POSTGRES_PASSWORD=troque-por-outra-senha-local-forte

# Acesso local ao Data Lake (MinIO)
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET=olist-data-lake

# Airflow local (perfil opcional airflow)
AIRFLOW_DB_PASSWORD=replace-with-a-random-hex-password
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_API_SECRET_KEY=replace-with-a-random-secret
# Gere segredos aleatórios no PowerShell; consulte docs/airflow.md.
AIRFLOW_JWT_SECRET=replace-with-a-random-64-byte-base64-secret
AIRFLOW_UID=50000
OLIST_SOURCE_DIR=C:/Users/Duh/Documents/olist-data-engeneering/data/source
